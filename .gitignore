# Saved boards record real paths from whatever document folder this is pointed
# at, so they can leak private structure. They stay local.
boards/
*.board.json

# The registry of folders you've pointed the canvas at — absolute paths into
# private work, same reasoning as boards/.
roots.json

# Local runtime junk
node_modules/
*.log
.env
.env.*

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Pasted screenshots live beside the boards that reference them, and carry the
# same privacy problem: they are pictures of real work.
assets/

assets.testbackup/
